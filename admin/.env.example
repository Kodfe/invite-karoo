# Copy to .env.local for `npm run dev`. All values are public (they end up in the browser).
# The API. Leave empty when it is on the same address as this site (one Vercel project serves both).
# For `npm run dev` against a local API: http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=

# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Local work against `firebase emulators:start`: 1 = use the emulators, not the real project.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
