# Copy to .env.local for `npm run dev`. All values are public (they end up in the browser).
# The API (Cloud Functions behind Firebase Hosting)
NEXT_PUBLIC_API_URL=https://api.invitekaroo.com

# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# UI tests only: 1 = fake sign-in (any email; password "wrong" fails). Never set for a real build.
# NEXT_PUBLIC_AUTH_MOCK=1
