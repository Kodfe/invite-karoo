# The API project's Environment Variables on Vercel, or functions/.env for `npm run dev`.
NODE_ENV=production
DEV_OTP=
PUBLIC_URL=https://api.invitekaroo.com
# The whole service account JSON, on one line. A secret: never give it a NEXT_PUBLIC_ name.
FIREBASE_SERVICE_ACCOUNT_JSON=
STORAGE_DRIVER=firebase
STORAGE_BUCKET=
OTP_SECRET=
CRON_SECRET=
CORS_ORIGINS=https://admin.invitekaroo.com,https://invite-karoo.vercel.app
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_TEMPLATE_LANG=en
TEAM_WHATSAPP=
ANTHROPIC_API_KEY=
