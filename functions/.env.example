# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL of this API (used for file links in local storage mode)
PUBLIC_URL=http://localhost:3000
# Comma separated list of web origins allowed to call the API (admin dashboard)
CORS_ORIGINS=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://ik:ik@localhost:5432/invitekaroo

# ─── Auth ─────────────────────────────────────────────────
# Long random strings. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ADMIN_SECRET=change-me-admin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# In development the OTP is always this code and nothing is sent.
# Leave empty in production.
DEV_OTP=1234

# ─── WhatsApp (OTP, invitations, reminders) ────────────────
# console = print messages to the log (development)
# meta    = WhatsApp Cloud API directly
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Approved template names (Meta Business Manager → WhatsApp → Message templates)
WA_TEMPLATE_OTP=ik_login_code
WA_TEMPLATE_INVITE=ik_function_invite
WA_TEMPLATE_REMINDER=ik_function_reminder
WA_TEMPLATE_LANG=en

# ─── Firebase (push + file storage) ────────────────────────
# Paste the service-account JSON as ONE line, or leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# ─── File storage ─────────────────────────────────────────
# local = ./uploads served by this API (development)
# firebase = Firebase Storage bucket above
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ─── AI card scan ─────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ─── First admin account (created by `npm run seed:admin`) ─
ADMIN_EMAIL=admin@invitekaroo.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Invite Karoo Admin

# Team WhatsApp number shown on "Host a wedding" (digits, with country code)
TEAM_WHATSAPP=919000000000
