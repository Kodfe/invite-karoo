{
  "name": "invite-karoo-functions",
  "version": "1.0.0",
  "description": "INVITE KAROO API on Firebase (Cloud Functions + Firestore + Firebase Auth)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "seed:admin": "node dist/db/seed-admin.js",
    "seed:demo": "node dist/db/seed-demo.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:emulators": "firebase emulators:exec --only firestore,auth,storage --project demo-invitekaroo \"jest --runInBand\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "firebase": "^13.2.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": "22"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "testTimeout": 30000,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {}
      ],
      "^.+/node_modules/jose/.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "target": "ES2022"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!jose/)"
    ]
  },
  "main": "dist/index.js"
}
