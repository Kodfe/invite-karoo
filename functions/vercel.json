{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "mkdir -p public",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": { "maxDuration": 300 }
  },
  "crons": [{ "path": "/v1/cron/minute", "schedule": "* * * * *" }]
}
